{
  "name": "tripmates",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:push": "tsx db/push.ts",
    "db:seed": "tsx db/seed.ts",
    "provision:super-admin": "tsx scripts/provision-super-admin.ts",
    "test:mysql": "pnpm db:push && pnpm db:seed && node --import tsx --test --test-timeout=180000 test/mysql.integration.test.ts",
    "test:e2e": "playwright test",
    "test:restart": "node --import tsx scripts/restart-persistence.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "drizzle-orm": "^0.39.3",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
